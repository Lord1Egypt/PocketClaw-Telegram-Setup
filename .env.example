# PocketClaw Telegram Setup — configuration template.
#
# On Vercel these go in Project Settings → Environment Variables.
# Locally, copy this file to .env and fill it in.
#
# NEVER commit a filled-in .env. The manager bot token is a server secret: it
# must never reach a browser, a repository, an APK, or a log line.

# ── Required ─────────────────────────────────────────────────────────────

# The manager bot's token, from @BotFather.
# Bot Management Mode must be enabled for this bot; see README.md.
TELEGRAM_MANAGER_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_MANAGER_BOT_TOKEN

# The manager bot's public @username, without the @.
# This is public: it appears in every managed-bot creation link.
TELEGRAM_MANAGER_BOT_USERNAME=PocketClawSetupBot

# A random string you invent. Telegram echoes it on every webhook delivery,
# which is how forged requests are rejected. At least 16 characters.
#   openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_STRING

# A random string you invent. It keys the stored poll-token verifier, so a
# dump of the storage backend cannot be replayed against this service.
# At least 16 characters. Changing it invalidates every live pairing.
#   openssl rand -hex 32
PAIRING_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_STRING

# ── Shared storage (required in production) ──────────────────────────────
#
# A Redis-compatible key/value store with an HTTP REST API — Upstash, or
# Vercel's Redis/KV integration, which provisions these automatically.
# Both naming conventions are accepted; set whichever pair you have.

KV_REST_API_URL=https://your-store.upstash.io
KV_REST_API_TOKEN=REPLACE_WITH_YOUR_STORAGE_TOKEN

# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Optional ─────────────────────────────────────────────────────────────

# Override the public origin used to build the Telegram webhook URL. Only
# needed behind a custom domain or proxy; otherwise it is detected from
# VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL, or the request host.
# PUBLIC_BASE_URL=https://setup.example.org

# How long a pairing lives before it is discarded. Keep it short: it bounds
# how long any token material can exist. Default 600.
# PAIRING_TTL_SECONDS=600

# Allow the in-memory store when no shared storage is configured.
# LOCAL DEVELOPMENT ONLY — it cannot work across serverless instances.
# ALLOW_MEMORY_STORE=true
